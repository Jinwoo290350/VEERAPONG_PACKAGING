# OpenRouter API key for the AI chat assistant — https://openrouter.ai/keys
# Copy this file to .env.local and fill in your key (never commit .env.local)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the free models used by the chat, comma-separated,
# in fallback order. Check current free models at https://openrouter.ai/models?q=free
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free

# Public site origin used by sitemap.xml, canonical tags, OG images and JSON-LD.
# Leave unset on Vercel — the stable production URL is detected automatically.
# Set it here (and in Vercel → Settings → Environment Variables) after buying a
# custom domain, e.g. https://www.veerapongpackaging.com
# NEXT_PUBLIC_SITE_URL=https://veerapong-packaging.vercel.app
